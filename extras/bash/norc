# bash completion for norc
#
# Install: copy to the bash-completion directory, e.g.
#   mkdir -p ~/.local/share/bash-completion/completions && cp extras/bash/norc ~/.local/share/bash-completion/completions/
# or source it in ~/.bashrc.

# Configured accounts: the files in <config dir>/accounts, and the directories with a conf
# (config dir from -c/--config)
_norc_accounts() {
	local dir="${XDG_CONFIG_HOME:-$HOME/.config}/norc" i
	for ((i = 1; i < ${#COMP_WORDS[@]} - 1; i++)); do
		case ${COMP_WORDS[i]} in
		-c | --config) dir=${COMP_WORDS[i + 1]/#\~/$HOME} ;;
		esac
	done
	local f
	for f in "$dir"/accounts/*; do
		[[ -f $f || -f $f/conf ]] && printf '%s\n' "${f##*/}"
	done
}

# norc ctl: its options, then a command completed by the running norc (norc complete: commands, contacts, rooms,
# files in the current directory, …)
_norc_ctl() {
	# the words after ctl as typed, split on spaces only (jids and nodes contain : and =)
	local line=${COMP_LINE:0:COMP_POINT}
	line=${line#* ctl }
	local -a words opts=()
	read -ra words <<<"$line"
	[[ -z $line || $line == *' ' ]] && words+=("")
	# the account and config of norc before ctl
	local i
	for ((i = 1; i < ${#COMP_WORDS[@]} - 1; i++)); do
		[[ ${COMP_WORDS[i]} == ctl ]] && break
		case ${COMP_WORDS[i]} in
		-a | --account | -c | --config) opts+=("${COMP_WORDS[i]}" "${COMP_WORDS[i + 1]}") ;;
		esac
	done
	# the options of norc ctl
	i=0
	while ((i < ${#words[@]} - 1)) && [[ ${words[i]} == -* ]]; do
		case ${words[i]} in
		-a | --account | -c | --config)
			opts+=("${words[i]}" "${words[i + 1]}")
			((i += 2))
			;;
		-t | --timeout | -n | --name) ((i += 2)) ;;
		*) ((i++)) ;;
		esac
	done
	# the value of an option
	((i >= ${#words[@]})) && return
	local cur=${words[${#words[@]} - 1]}
	if ((i == ${#words[@]} - 1)) && [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "-a --account -c --config --json -t --timeout -s --stdin -l --lines -n --name -h --help" -- "$cur"))
		return
	fi
	local out
	out=$(norc complete "${opts[@]}" -- "${words[@]:i}" 2>/dev/null) || return
	[[ -n $out ]] || return
	mapfile -t COMPREPLY <<<"$out"
	# readline replaces the text after the last : or = of the word
	local cut=${cur%"${cur##*[:=]}"}
	[[ -n $cut ]] && COMPREPLY=("${COMPREPLY[@]#"$cut"}")
	# a directory: no space after it
	((${#COMPREPLY[@]} == 1)) && [[ ${COMPREPLY[0]} == */ ]] && compopt -o nospace 2>/dev/null
}

_norc() {
	local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD - 1]}
	COMPREPLY=()
	local options="-a --account -j --jid -c --config --host --port --resource -i --interactive --no-input --api --stdin --xmpp-debug --no-color --silent -v --version -h --help"

	# values of options
	case $prev in
	-a | --account)
		local IFS=$'\n'
		COMPREPLY=($(compgen -W "$(_norc_accounts)" -- "$cur"))
		return
		;;
	-c | --config)
		compopt -o filenames 2>/dev/null
		COMPREPLY=($(compgen -d -- "$cur"))
		return
		;;
	--host)
		COMPREPLY=($(compgen -A hostname -- "$cur"))
		return
		;;
	-j | --jid | --port | --resource | --timeout)
		return
		;;
	esac

	# the command and its arguments (skipping options and their values)
	local i word command="" subcommand="" args=0
	for ((i = 1; i < COMP_CWORD; i++)); do
		word=${COMP_WORDS[i]}
		case $word in
		-a | --account | -j | --jid | -c | --config | --host | --port | --resource | --timeout) ((i++)) ;;
		-*) ;;
		*)
			if [[ -z $command ]]; then
				command=$word
			elif [[ -z $subcommand ]]; then
				subcommand=$word
			else
				((args++))
			fi
			;;
		esac
	done

	if [[ -z $command ]]; then
		if [[ $cur == -* ]]; then
			COMPREPLY=($(compgen -W "$options" -- "$cur"))
		else
			COMPREPLY=($(compgen -W "account check ctl complete" -- "$cur"))
		fi
		return
	fi

	if [[ $command == ctl ]]; then
		_norc_ctl
		return
	fi

	# norc check <domain...>: its options, or server domains
	if [[ $command == check ]]; then
		if [[ $cur == -* ]]; then
			COMPREPLY=($(compgen -W "--json --timeout --port --xmpp-debug --no-color -c --config" -- "$cur"))
		else
			COMPREPLY=($(compgen -A hostname -- "$cur"))
		fi
		return
	fi

	[[ $command == account ]] || return
	if [[ -z $subcommand ]]; then
		COMPREPLY=($(compgen -W "register unregister passwd list help" -- "$cur"))
		return
	fi
	local extra=""
	case $subcommand in
	register) extra="--save" ;;
	unregister) extra="--yes --purge" ;;
	esac
	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W "$options $extra" -- "$cur"))
	elif ((args == 0)) && [[ $subcommand == unregister || $subcommand == passwd ]]; then
		local IFS=$'\n'
		COMPREPLY=($(compgen -W "$(_norc_accounts)" -- "$cur"))
	fi
}

complete -F _norc norc
