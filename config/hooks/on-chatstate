#!/bin/sh
#
# norc hook: show who is typing, e.g. in a status bar (a file per contact)
#
# Run on the chatstate event, when a contact starts or stops typing.
# Enable it with `chmod +x on-chatstate`. Several hooks per event: on-chatstate.<anything> (e.g. on-chatstate.log).
#
# Arguments: from (bare jid) state
# NORC_FROM   full jid
# NORC_NAME   name of the contact
# NORC_STATE  composing (typing), paused, active, inactive, gone
# Always set: NORC_EVENT NORC_ACCOUNT (the account name) NORC_JID (your jid)

dir="${XDG_RUNTIME_DIR:-/tmp}/norc-typing"
mkdir -p "$dir"
# the file exists while the contact is typing
if [ "$2" = composing ]; then
	echo "$NORC_NAME" > "$dir/$1"
else
	rm -f "$dir/$1"
fi
