#!/bin/sh
#
# norc hook: log the messages you sent, with their ids (on-receipt marks them delivered)
#
# Run on the sent event, when you sent a message (also from another of your clients).
# Enable it with `chmod +x on-sent`. Several hooks per event: on-sent.<anything> (e.g. on-sent.log).
#
# Arguments: to (bare jid) body
# NORC_TO        jid of the recipient
# NORC_NAME      name of the contact
# NORC_BODY      the text
# NORC_ID        id of the message (see on-receipt)
# NORC_TYPE      chat, normal, groupchat (to a room: shown again as room event when the room sends it back)
# NORC_CARBON    1 if sent by another of your clients
# NORC_REPLACES  for a correction: the id of the corrected message
# NORC_REPLY_ID  for a reply: the id of the message replied to (NORC_BODY is without its quote)
# NORC_REPLY_TO  for a reply: the author of the message replied to
# Always set: NORC_EVENT NORC_ACCOUNT (the account name) NORC_JID (your jid)

# ~/.local/share/norc/logs/<account>/sent.log, readable only by you (all messages, in and out, per contact: the
# script log-messages)
log="${XDG_DATA_HOME:-$HOME/.local/share}/norc/logs/$NORC_ACCOUNT"
umask 077
mkdir -p "$log"
printf '%s %s → %s: %s\n' "$(date '+%F %T')" "$NORC_ID" "$1" "$2" >> "$log/sent.log"
